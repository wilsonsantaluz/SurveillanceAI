          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Tr T3889ce7e856b26c8}" Style="{StaticResource Title}"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Audit}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr T4aee1f423b8a3a10}" Binding="{Binding TimestampUtc, StringFormat=g}" Width="160"/>
                <DataGridTextColumn Header="{loc:Tr T64cff1319d2fd2cb}" Width="*">
                  <DataGridTextColumn.Binding>
                    <MultiBinding Converter="{StaticResource LocalizedValue}">
                      <Binding Path="Action"/>
                      <Binding Source="{x:Static i18n:Texts.Instance}" Path="LanguageTag"/>
                    </MultiBinding>
                  </DataGridTextColumn.Binding>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="{loc:Tr T6b0cc904d081a8c1}" Visibility="{Binding Administrator, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TabUsers">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
          </Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Tr Te3b89e9d33f88e52}" Binding="{Binding Username}" Width="*"/>
              <DataGridTextColumn Header="{loc:Tr T14736a2eb9f4159f}" Width="*">
                <DataGridTextColumn.Binding>
                  <MultiBinding Converter="{StaticResource LocalizedValue}">
                    <Binding Path="Role"/>
                    <Binding Source="{x:Static i18n:Texts.Instance}" Path="LanguageTag"/>
                  </MultiBinding>
                </DataGridTextColumn.Binding>
              </DataGridTextColumn>
              <DataGridCheckBoxColumn Header="{loc:Tr T92340695899bd2d8}" Binding="{Binding Active}"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="{loc:Tr T832b508b1f614d34}" Style="{StaticResource Title}"/>
              <Button Content="{loc:Tr T6384ffa7712cb2d5}" Command="{Binding NewUserCommand}"/>
              <TextBlock Text="{loc:Tr Te3b89e9d33f88e52}"/>
              <TextBox Text="{Binding UserDraft.Username}"/>
              <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding UserDraft.Role}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}"/>
              <CheckBox Content="{loc:Tr T92340695899bd2d8}" IsChecked="{Binding UserDraft.Active}"/>
              <TextBlock Text="{loc:Tr Ta8aa0960d45ebc2f}"/>
              <PasswordBox x:Name="UserPassword"/>
              <Button Content="{loc:Tr T038128ec4d37e4e5}" Command="{Binding SaveUserCommand}" CommandParameter="{Binding ElementName=UserPassword}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="{loc:Tr Tb53181a4d853c390}" AutomationProperties.AutomationId="TabMyaccount">
        <Border Style="{StaticResource Card}" Width="420" HorizontalAlignment="Left" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{loc:Tr T8a6a1da8ec839127}" Style="{StaticResource Title}"/>
            <StackPanel x:Name="PasswordChangePanel">
              <TextBlock Text="{loc:Tr T72ed2bd767cef627}"/>
              <PasswordBox/>
              <TextBlock Text="{loc:Tr Tdeb54cdd6f279d26}"/>
              <PasswordBox/>
            </StackPanel>
            <Button Content="{loc:Tr T3f9c991f63a9a376}" Command="{Binding ChangePasswordCommand}" CommandParameter="{Binding ElementName=PasswordChangePanel}"/>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="#F4BD61" TextWrapping="Wrap" Margin="4,12,4,0" AutomationProperties.AutomationId="StatusMessage"/>
    <Border Grid.RowSpan="3" Background="#080F1B" DataContext="{Binding}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding FullscreenCamera}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid Margin="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock Text="{Binding FullscreenCamera.Name}" Style="{StaticResource Title}"/>
          <Button Content="{loc:Tr T02e565ef63bc0338}" Command="{Binding CloseFullscreenCommand}" HorizontalAlignment="Right" AutomationProperties.AutomationId="CloseFullscreen"/>
        </DockPanel>
        <Image Grid.Row="1" Source="{Binding FullscreenCamera.Image}" Stretch="Uniform"/>
        <TextBlock Grid.Row="2" Text="{Binding FullscreenCamera.Metrics}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
