<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SurveillanceAI.Desktop.Localization" xmlns:i18n="clr-namespace:SurveillanceAI.Application.Localization;assembly=SurveillanceAI.Application">
  <loc:LocalizedValueConverter x:Key="LocalizedValue"/>
  <DataTemplate x:Key="LocalizedChoiceTemplate">
    <TextBlock Foreground="#101C2D">
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource LocalizedValue}">
          <Binding/>
          <Binding Source="{x:Static i18n:Texts.Instance}" Path="LanguageTag"/>
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </DataTemplate>
  <Color x:Key="Navy">#0B1220</Color>
  <Color x:Key="Slate">#172337</Color>
  <Color x:Key="Cyan">#35D1C4</Color>
  <Color x:Key="Purple">#A99AF7</Color>
  <Color x:Key="Amber">#F4BD61</Color>
  <Color x:Key="Critical">#F36D7A</Color>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Navy}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Slate}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Cyan}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A4B3CA"/>
  <Thickness x:Key="CardPadding">14</Thickness>
  <Thickness x:Key="ControlSpacing">4</Thickness>
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    <Setter Property="Foreground" Value="#EDF2FA"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Margin" Value="4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="4,4,4,14"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Background" Value="#253951"/>
    <Setter Property="Foreground" Value="#EDF2FA"/>
    <Setter Property="BorderBrush" Value="#3C536C"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="#071B25"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Background" Value="#101C2D"/>
    <Setter Property="Foreground" Value="#EDF2FA"/>
    <Setter Property="CaretBrush" Value="White"/>
    <Setter Property="BorderBrush" Value="#3C536C"/>
    <Setter Property="MinWidth" Value="80"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Background" Value="#101C2D"/>
    <Setter Property="Foreground" Value="#EDF2FA"/>
    <Setter Property="BorderBrush" Value="#3C536C"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="7,5"/>
    <Setter Property="MinWidth" Value="100"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="6,8"/>
    <Setter Property="Foreground" Value="#EDF2FA"/>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="#EDF2FA"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Padding="{TemplateBinding Padding}" Margin="0,0,6,8" Background="{TemplateBinding Background}" CornerRadius="5">
            <ContentPresenter x:Name="TabHeader" ContentSource="Header" TextElement.Foreground="{StaticResource MutedBrush}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Tab" Property="Background" Value="#253951"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="#101C2D"/>
    <Setter Property="Foreground" Value="#EDF2FA"/>
    <Setter Property="RowBackground" Value="#172337"/>
    <Setter Property="AlternatingRowBackground" Value="#142033"/>
    <Setter Property="BorderBrush" Value="#2A3B52"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="RowHeight" Value="32"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="Margin" Value="4"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#253951"/>
    <Setter Property="Foreground" Value="#A4B3CA"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="#2A3B52"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    <Setter Property="Margin" Value="4"/>
  </Style>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
</ResourceDictionary>
